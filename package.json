{
  "name": "pirip-2027-lecture-course",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "generate": "node scripts/generate-course.mjs",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/check-course.mjs",
    "check:readiness": "node scripts/check-course.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "build:pages": "npm run build",
    "test": "node scripts/check-course.mjs",
    "lint": "oxlint src scripts authoring/blocks.mjs",
    "export:pdf": "node scripts/export-pdf.mjs",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@olgakraven/lecture-engine": "file:vendor/olgakraven-lecture-engine-0.2.0.tgz",
    "lucide-react": "1.38.0",
    "motion": "13.1.1",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "oxlint": "1.80.0",
    "@playwright/test": "1.62.1",
    "pdfjs-dist": "6.3.289",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0"
  }
}
